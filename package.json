{
  "name": "liveedge-even-g2",
  "version": "0.1.0",
  "private": true,
  "description": "Heads-up Polymarket live match pulse & risk-gated one-tap execution HUD for Even Realities G2 smart glasses",
  "type": "module",
  "author": "RedKoi Research",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:ehpk": "evenhub pack app.json ./dist -o ./release/liveedge-hud.ehpk --sdk-ver 0.0.16",
    "check:all": "node ./scripts/self_check.mjs",
    "record:demo": "node ./scripts/record_demo_video.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.49.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
